# Copy to .env (git-ignored) and fill in. Never commit .env.
QLOO_API_KEY=
YOUTUBE_API_KEY=

# Optional: a language model for the conversation agent (rules work without it).
# Local and private: install Ollama (https://ollama.com), run `ollama pull llama3.2`, and Reach finds it.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# Or a hosted model (your words are sent to that provider):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# REACH_LLM=off

# Shown on /judge as the source link (your public GitHub repo URL).
# REACH_REPO_URL=https://github.com/you/reach
